{
  "name": "@nightnetwork/dpm",
  "version": "1.0.0",
  "description": "Browser WebAssembly core of the Dusk Package Manager",
  "type": "module",
  "license": "Apache-2.0",
  "author": "NightNetwork",
  "repository": {
    "type": "git",
    "url": "https://github.com/nightnetwork/dpm.git"
  },
  "homepage": "https://github.com/nightnetwork/dpm",
  "bugs": {
    "url": "https://github.com/nightnetwork/dpm/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/dpm_wasm.d.ts",
      "default": "./dist/dpm_wasm.js"
    },
    "./wasm": "./dist/dpm_wasm_bg.wasm"
  },
  "files": [
    "dist/dpm_wasm.js",
    "dist/dpm_wasm.d.ts",
    "dist/dpm_wasm_bg.wasm",
    "dist/dpm_wasm_bg.wasm.d.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:package": "node --test test/package-contract.test.mjs",
    "test:browser": "node --test test/browser-package.test.mjs",
    "build:wasm": "node scripts/build-wasm.mjs",
    "prepack": "npm run build:wasm"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "playwright-core": "1.55.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  },
  "keywords": [
    "webassembly",
    "browser",
    "duskjs",
    "dpm"
  ],
  "engines": {
    "node": ">=18"
  }
}
