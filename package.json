{
  "name": "@nightnetwork/dpm",
  "version": "0.1.0",
  "description": "Dusk Package Manager — npm-compatible package manager for Node and DuskJS",
  "type": "module",
  "license": "Apache-2.0",
  "author": "NightNetwork",
  "repository": {
    "type": "git",
    "url": "https://github.com/nightnetwork/dpm.git"
  },
  "homepage": "https://github.com/nightnetwork/dpm",
  "bugs": {
    "url": "https://github.com/nightnetwork/dpm/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "dpm": "./dist/cli/dpm.js",
    "dpx": "./dist/cli/dpx.js",
    "npm": "./dist/cli/npm.js",
    "npx": "./dist/cli/npx.js",
    "pnpm": "./dist/cli/pnpm.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.0.0",
    "@types/node": "^20.0.0"
  },
  "keywords": [
    "package-manager",
    "npm",
    "duskjs",
    "dpm"
  ],
  "engines": {
    "node": ">=18"
  }
}
